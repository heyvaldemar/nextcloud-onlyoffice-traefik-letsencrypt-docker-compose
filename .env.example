# Nextcloud + ONLYOFFICE Docs + Traefik + Let's Encrypt — Environment Variables
# Copy this file to `.env` and fill in each value before `docker compose up`.
# `.env` is gitignored — never commit real credential values.
#
# Image versions are NOT set here. The tested tag + sha256 digest for every
# image lives in the compose file's `x-images` block, so `git pull` delivers
# the version combination this repository has tested. To pin a different
# version yourself, uncomment and set the matching *_IMAGE_TAG variable, e.g.:
# NEXTCLOUD_IMAGE_TAG=nextcloud:34.0.3@sha256:…
# ONLYOFFICE_DOCUMENT_IMAGE_TAG=onlyoffice/documentserver:9.4.0@sha256:…

# ──────────────────────────────────────────────────────────────────────────────
# Traefik reverse proxy
# ──────────────────────────────────────────────────────────────────────────────

# Email address for Let's Encrypt renewal notices. REQUIRED.
TRAEFIK_ACME_EMAIL=admin@example.com

# Hostname for the Traefik dashboard (basic-auth protected). REQUIRED.
TRAEFIK_HOSTNAME=traefik.nextcloud.example.com

# Basic Authentication for the Traefik dashboard.
# Format: USERNAME:BCRYPT_HASH (with $ characters doubled to $$ for compose)
#     htpasswd -nbB traefikadmin YOUR_STRONG_PASSWORD | sed 's/\$/\$\$/g'
# REQUIRED — do not ship production without changing this.
TRAEFIK_BASIC_AUTH=change_me_generate_with_htpasswd_and_replace_this_string

# Log level: DEBUG, INFO, WARN, ERROR. Default: WARN.
# TRAEFIK_LOG_LEVEL=WARN

# ──────────────────────────────────────────────────────────────────────────────
# Nextcloud
# ──────────────────────────────────────────────────────────────────────────────

# Public hostname for Nextcloud. Must resolve to this server's public IP for
# the Let's Encrypt TLS-ALPN challenge. REQUIRED.
NEXTCLOUD_HOSTNAME=nextcloud.example.com

# Full public URL — https:// plus the hostname above. REQUIRED.
NEXTCLOUD_URL=https://nextcloud.example.com

# REQUIRED — generate each with:
#     openssl rand -base64 24 | tr -d '/+=' | head -c 32
NEXTCLOUD_DB_PASSWORD=change_me_before_first_start
NEXTCLOUD_REDIS_PASSWORD=change_me_before_first_start
NEXTCLOUD_ADMIN_PASSWORD=change_me_before_first_start

# Defaults below are set in the compose file; override only to diverge.
# NEXTCLOUD_ADMIN_USERNAME=nextcloudadmin
# NEXTCLOUD_DB_NAME=nextclouddb
# NEXTCLOUD_DB_USER=nextclouddbuser
# NEXTCLOUD_TIMEZONE=America/New_York

# ──────────────────────────────────────────────────────────────────────────────
# ONLYOFFICE Docs (document server)
# ──────────────────────────────────────────────────────────────────────────────

# Public hostname for the document server — a separate subdomain that must
# also resolve to this server. REQUIRED.
ONLYOFFICE_DOCUMENT_HOSTNAME=onlyoffice.example.com

# REQUIRED — generate each with the openssl command above. The JWT secret
# is what Nextcloud uses to authenticate against the document server;
# you will enter it in the ONLYOFFICE connector app settings.
ONLYOFFICE_DOCUMENT_DB_PASSWORD=change_me_before_first_start
ONLYOFFICE_DOCUMENT_JWT_SECRET=change_me_before_first_start

# Defaults below are set in the compose file; override only to diverge.
# ONLYOFFICE_DOCUMENT_DB_NAME=onlyofficedb
# ONLYOFFICE_DOCUMENT_DB_USER=onlyofficedbuser

# ──────────────────────────────────────────────────────────────────────────────
# RabbitMQ (ONLYOFFICE message queue)
# ──────────────────────────────────────────────────────────────────────────────

# REQUIRED — generate with the openssl command above.
RABBITMQ_PASSWORD=change_me_before_first_start

# RABBITMQ_USER=rabbitmqdb

# ──────────────────────────────────────────────────────────────────────────────
# Backups (defaults shown; override only to tune)
# ──────────────────────────────────────────────────────────────────────────────

# BACKUP_INIT_SLEEP=30m
# BACKUP_INTERVAL=24h
# POSTGRES_BACKUP_PRUNE_DAYS=7
# DATA_BACKUP_PRUNE_DAYS=7
# POSTGRES_BACKUPS_PATH=/srv/nextcloud-postgres/backups
# DATA_BACKUPS_PATH=/srv/nextcloud-application-data/backups
# DATA_PATH=/var/www/html
# POSTGRES_BACKUP_NAME=nextcloud-postgres-backup
# DATA_BACKUP_NAME=nextcloud-application-data-backup

# Resource limits (defaults shown). Each service carries memory/CPU limits and
# reservations as compose-level defaults; override any of them here and the
# override survives every git pull. Sizing is per host: raise a limit if a
# service is OOM-killed (docker inspect shows OOMKilled=true).
# NEXTCLOUD_ONLYOFFICE_POSTGRES_NEXTCLOUD_MEMORY_LIMIT=1g
# NEXTCLOUD_ONLYOFFICE_POSTGRES_NEXTCLOUD_CPU_LIMIT=1.0
# NEXTCLOUD_ONLYOFFICE_POSTGRES_NEXTCLOUD_MEMORY_RESERVATION=128m
# NEXTCLOUD_ONLYOFFICE_POSTGRES_NEXTCLOUD_CPU_RESERVATION=0.25
# NEXTCLOUD_ONLYOFFICE_REDIS_NEXTCLOUD_MEMORY_LIMIT=256m
# NEXTCLOUD_ONLYOFFICE_REDIS_NEXTCLOUD_CPU_LIMIT=0.5
# NEXTCLOUD_ONLYOFFICE_REDIS_NEXTCLOUD_MEMORY_RESERVATION=32m
# NEXTCLOUD_ONLYOFFICE_REDIS_NEXTCLOUD_CPU_RESERVATION=0.1
# NEXTCLOUD_ONLYOFFICE_NEXTCLOUD_MEMORY_LIMIT=1g
# NEXTCLOUD_ONLYOFFICE_NEXTCLOUD_CPU_LIMIT=1.0
# NEXTCLOUD_ONLYOFFICE_NEXTCLOUD_MEMORY_RESERVATION=128m
# NEXTCLOUD_ONLYOFFICE_NEXTCLOUD_CPU_RESERVATION=0.25
# NEXTCLOUD_ONLYOFFICE_NEXTCLOUD_CRON_MEMORY_LIMIT=512m
# NEXTCLOUD_ONLYOFFICE_NEXTCLOUD_CRON_CPU_LIMIT=1.0
# NEXTCLOUD_ONLYOFFICE_NEXTCLOUD_CRON_MEMORY_RESERVATION=64m
# NEXTCLOUD_ONLYOFFICE_NEXTCLOUD_CRON_CPU_RESERVATION=0.25
# NEXTCLOUD_ONLYOFFICE_POSTGRES_ONLYOFFICE_DOCUMENT_MEMORY_LIMIT=1g
# NEXTCLOUD_ONLYOFFICE_POSTGRES_ONLYOFFICE_DOCUMENT_CPU_LIMIT=1.0
# NEXTCLOUD_ONLYOFFICE_POSTGRES_ONLYOFFICE_DOCUMENT_MEMORY_RESERVATION=128m
# NEXTCLOUD_ONLYOFFICE_POSTGRES_ONLYOFFICE_DOCUMENT_CPU_RESERVATION=0.25
# NEXTCLOUD_ONLYOFFICE_REDIS_ONLYOFFICE_DOCUMENT_MEMORY_LIMIT=256m
# NEXTCLOUD_ONLYOFFICE_REDIS_ONLYOFFICE_DOCUMENT_CPU_LIMIT=0.5
# NEXTCLOUD_ONLYOFFICE_REDIS_ONLYOFFICE_DOCUMENT_MEMORY_RESERVATION=32m
# NEXTCLOUD_ONLYOFFICE_REDIS_ONLYOFFICE_DOCUMENT_CPU_RESERVATION=0.1
# NEXTCLOUD_ONLYOFFICE_RABBITMQ_ONLYOFFICE_DOCUMENT_MEMORY_LIMIT=512m
# NEXTCLOUD_ONLYOFFICE_RABBITMQ_ONLYOFFICE_DOCUMENT_CPU_LIMIT=0.5
# NEXTCLOUD_ONLYOFFICE_RABBITMQ_ONLYOFFICE_DOCUMENT_MEMORY_RESERVATION=64m
# NEXTCLOUD_ONLYOFFICE_RABBITMQ_ONLYOFFICE_DOCUMENT_CPU_RESERVATION=0.1
# NEXTCLOUD_ONLYOFFICE_ONLYOFFICE_DOCUMENT_MEMORY_LIMIT=2g
# NEXTCLOUD_ONLYOFFICE_ONLYOFFICE_DOCUMENT_CPU_LIMIT=2.0
# NEXTCLOUD_ONLYOFFICE_ONLYOFFICE_DOCUMENT_MEMORY_RESERVATION=256m
# NEXTCLOUD_ONLYOFFICE_ONLYOFFICE_DOCUMENT_CPU_RESERVATION=0.5
# TRAEFIK_MEMORY_LIMIT=256m
# TRAEFIK_CPU_LIMIT=0.5
# TRAEFIK_MEMORY_RESERVATION=64m
# TRAEFIK_CPU_RESERVATION=0.1
# NEXTCLOUD_ONLYOFFICE_BACKUPS_MEMORY_LIMIT=256m
# NEXTCLOUD_ONLYOFFICE_BACKUPS_CPU_LIMIT=0.5
# NEXTCLOUD_ONLYOFFICE_BACKUPS_MEMORY_RESERVATION=32m
# NEXTCLOUD_ONLYOFFICE_BACKUPS_CPU_RESERVATION=0.1

# How long docker waits for a data-owning service to shut down before it
# sends SIGKILL. The default of ten seconds can cut short a PostgreSQL
# checkpoint, an InnoDB flush or a Redis save; sixty is the value this
# repository ships. Raise it if your dataset is large.
# NEXTCLOUD_ONLYOFFICE_POSTGRES_NEXTCLOUD_STOP_GRACE_PERIOD NEXTCLOUD_ONLYOFFICE_REDIS_NEXTCLOUD_STOP_GRACE_PERIOD NEXTCLOUD_ONLYOFFICE_POSTGRES_ONLYOFFICE_DOCUMENT_STOP_GRACE_PERIOD NEXTCLOUD_ONLYOFFICE_REDIS_ONLYOFFICE_DOCUMENT_STOP_GRACE_PERIOD =60s

# Image versions. Every image is pinned by digest inside the compose file
# (x-images block); set the matching variable here to run a different version
# of that one image (Compose then pulls the tag, without a digest) while every
# other pin stays as tested. Setting <PREFIX>_IMAGE_TAG replaces the whole
# reference instead. Needs Docker Compose v2.5 or newer (2022).
# TRAEFIK_IMAGE_VERSION=3.7
# NEXTCLOUD_POSTGRES_IMAGE_VERSION=16
# NEXTCLOUD_REDIS_IMAGE_VERSION=7.4
# NEXTCLOUD_IMAGE_VERSION=34.0.3
# ONLYOFFICE_DOCUMENT_POSTGRES_IMAGE_VERSION=16
# ONLYOFFICE_DOCUMENT_REDIS_IMAGE_VERSION=7.4
# ONLYOFFICE_DOCUMENT_IMAGE_VERSION=9.4.0
# RABBITMQ_IMAGE_VERSION=4.3-management
